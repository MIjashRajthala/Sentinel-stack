# SHOG environment configuration
# Copy this file to .env. install.sh generates all blank secret values.

TZ=UTC
MANAGEMENT_IP=127.0.0.1
HOSTNAME=shog-docker-host
SHOG_MODE=full

# Docker networks
MGMT_SUBNET=172.27.1.0/24
SEC_SUBNET=172.28.1.0/24
MON_SUBNET=172.29.1.0/24

# Core service addresses
PORTAINER_IP=172.27.1.2
UPTIME_KUMA_IP=172.27.1.3
UNBOUND_IP=172.28.1.3
PIHOLE_IP=172.28.1.2
PIHOLE_WEB_IP=127.0.0.1
# Filled by scripts/prepare-environment.sh. Use a stable LAN address that
# pfSense clients can reach; binding a specific address avoids conflicts with
# systemd-resolved on 127.0.0.53.
PIHOLE_DNS_BIND_IP=
PIHOLE_MAXDB_DAYS=30
RSYSLOG_IP=172.28.1.4
CROWDSEC_IP=172.28.1.5
WAZUH_INDEXER_IP=172.28.1.10
WAZUH_MANAGER_IP=172.28.1.11
WAZUH_DASHBOARD_IP=172.28.1.12
FILEBEAT_IP=172.28.1.15
WAZUH_INDEXER_HEAP=1g

# Generated automatically by scripts/generate-secrets.sh
PIHOLE_WEBPASSWORD=
CROWDSEC_BOUNCER_KEY=
WAZUH_INDEXER_PASSWORD=
WAZUH_API_PASSWORD=

# Optional alerting profile
ALERTING_WEBHOOK_URL=
ALERTING_SMTP_HOST=
ALERTING_SMTP_PORT=587
ALERTING_SMTP_USER=
ALERTING_SMTP_PASS=
ALERTING_FROM=
ALERTING_TO=

# Optional OpenCTI profile
OPENCTI_BASE_URL=http://localhost:8088
OPENCTI_ADMIN_EMAIL=admin@example.com
OPENCTI_ADMIN_PASSWORD=
OPENCTI_ADMIN_TOKEN=
OPENCTI_ES_PASSWORD=
OPENCTI_ES_HEAP=2g
OPENCTI_MINIO_ACCESS_KEY=
OPENCTI_MINIO_SECRET_KEY=
OPENCTI_RABBITMQ_USER=opencti
OPENCTI_RABBITMQ_PASS=
OPENCTI_CONNECTOR_MITRE_ID=
